# API FastAPI (Python 3.12). ffmpeg : analyse vidéo ; nodejs : défis JavaScript de yt-dlp.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg nodejs ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.18 /uv /usr/local/bin/uv
WORKDIR /app
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY observer ./observer
COPY eval ./eval
COPY data/registry ./data/registry
COPY data/eval ./data/eval
RUN uv sync --frozen --no-dev && useradd -m -u 10001 app && mkdir -p data/raw && chown -R app /app/data
USER app
EXPOSE 8010
CMD ["uv", "run", "--no-sync", "uvicorn", "observer.api.main:app", "--host", "0.0.0.0", "--port", "8010", "--proxy-headers"]
